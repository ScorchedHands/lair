<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The KV-format spike measures fixed-size block structs over pinned arenas, exactly the shape a quantized pool stores. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The low-rank spike's spectrum script ships beside the bench binary: exact numpy singular values come from here, not from a managed approximation. -->
    <Content Include="spikes\lowrank-svd.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lair.Contracts\Lair.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Lair.Loader\Lair.Loader.csproj" />
    <ProjectReference Include="..\..\src\Lair.Backends.Cpu\Lair.Backends.Cpu.csproj" />
    <ProjectReference Include="..\..\src\Lair.Backends.Cuda\Lair.Backends.Cuda.csproj" />
    <ProjectReference Include="..\..\src\Lair.Kv\Lair.Kv.csproj" />
    <ProjectReference Include="..\..\src\Lair.Models\Lair.Models.csproj" />
    <ProjectReference Include="..\..\src\Lair.Tokenizer\Lair.Tokenizer.csproj" />
  </ItemGroup>

</Project>
